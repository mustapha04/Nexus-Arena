rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Helper Primitives
    function isSignedIn() { return request.auth != null; }
    
    // Compare email safely case-insensitively
    function isHardcodedAdmin() {
      return isSignedIn() && 
             request.auth.token != null && 
             request.auth.token.email != null && 
             (request.auth.token.email == 'mustaphaelibrahimi6@gmail.com' || 
              request.auth.token.email.matches('(?i)^mustaphaelibrahimi6@gmail\\.com$'));
    }
    
    function isAdmin() { 
      return isHardcodedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('role', 'user') == 'admin'
      );
    }
    
    function isNotBanned() { 
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) || 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('isBanned', false) != true
      ); 
    }
    
    function isVerified() { 
      return isSignedIn() && isNotBanned(); 
    }
    function isOwner(userId) { return isSignedIn() && (request.auth.uid == userId); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Validation Helpers using robust 'in' operator to avoid nested map/keys parsing issues
    function isValidProfile(data) {
      return 'id' in data && data.id is string &&
             'email' in data && data.email is string &&
             'username' in data && data.username is string &&
             'avatar_url' in data && data.avatar_url is string &&
             'role' in data && data.role in ['user', 'admin'] &&
             'created_at' in data && data.created_at is string &&
             (!('combat_level' in data) || data.combat_level is int) &&
             (!('artifacts_found' in data) || data.artifacts_found is int) &&
             (!('grid_uptime' in data) || data.grid_uptime is string) &&
             (!('core_integrity' in data) || data.core_integrity is string) &&
             (!('isBanned' in data) || data.isBanned is bool);
    }

    // Default catch-all rule for defense in depth
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Match Blocks

    // Profiles
    match /profiles/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidProfile(incoming()) && (incoming().role == 'user' || isHardcodedAdmin());
      allow update: if (isOwner(userId) && isValidProfile(incoming()) && (incoming().role == existing().role || isHardcodedAdmin())) || isAdmin();
    }

    // Lists (Custom Game Collections)
    match /lists/{listId} {
      allow read: if true;
      allow create: if isVerified() && incoming().user_id == request.auth.uid;
      allow update, delete: if isVerified() && (isOwner(existing().user_id) || isAdmin());
    }

    // Favorites & Wishlists (with guards for null resource and robust global list operations for admins)
    match /favorites/{favId} {
      allow list: if isSignedIn() && (isAdmin() || resource == null || resource.data.user_id == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource == null || resource.data.user_id == request.auth.uid);
      allow create, update: if isVerified() && incoming().user_id == request.auth.uid;
      allow delete: if isVerified() && (isOwner(existing().user_id) || isAdmin());
    }
    
    match /wishlists/{wishId} {
      allow list: if isSignedIn() && (isAdmin() || resource == null || resource.data.user_id == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource == null || resource.data.user_id == request.auth.uid);
      allow create, update: if isVerified() && incoming().user_id == request.auth.uid;
      allow delete: if isVerified() && (isOwner(existing().user_id) || isAdmin());
    }

    // Game Stats
    match /game_stats/{statId} {
      allow read: if true;
      allow create, update: if true; 
    }

    // Homepage Config
    match /homepage_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ratings in standard details
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isVerified() && incoming().user_id == request.auth.uid;
      allow delete: if isVerified() && (isOwner(existing().user_id) || isAdmin());
    }

    // Comments Moderation and creation
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isVerified() && incoming().user_id == request.auth.uid && incoming().username is string && incoming().content.size() <= 1000;
      allow update: if isVerified() && (
        ((isOwner(existing().user_id) || isAdmin()) && incoming().diff(existing()).affectedKeys().hasOnly(['content'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'liked_by']))
      );
      allow delete: if isVerified() && (isOwner(existing().user_id) || isAdmin());
    }

    // Affiliate Links (Admin only)
    match /affiliate_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Affiliate Clicks
    match /affiliate_clicks/{clickId} {
      allow create: if true; 
      allow read: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isOwner(resource.data.user_id);
      allow create: if isAdmin();
    }
  }
}
